# Client registered at your OIDC provider with redirect URI <app-url>/login/oauth2/code/sso
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER_URI=https://id.example.com
OIDC_LABEL=Single sign-on
# google, keycloak, pocket-id or generic
OIDC_ICON=generic

# Second provider, when enabled in docker-compose.yml
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Comma-separated
ADMIN_EMAILS=admin@example.com
ALLOWED_DOMAINS=
ALLOWED_EMAILS=

# Host folder served at /srv/files inside the container
FILES_PATH=/srv/files
